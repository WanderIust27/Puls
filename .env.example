# Persönliche Einstellungen für PULS.
#
# Einmalig kopieren:   cp .env.example .env
# Danach die .env ausfüllen. Sie wird bei einem Update NICHT überschrieben,
# weil sie nicht Teil des Pakets ist — deine Werte bleiben also erhalten.

TZ=Europe/Berlin

# ------------------------------------------------------------------- Zugriff
# Unter welchem Port ist PULS im Browser erreichbar?
# Nach einer Änderung: Stack neu deployen.
PULS_PORT=1337

# ---------------------------------------------------------------- KI-Modell
# Kleiner und schneller auf CPU: qwen2.5:3b-instruct-q4_K_M
OLLAMA_MODEL=qwen3:8b
SYNC_INTERVAL_HOURS=3

# Grafikkarte für das KI-Modell. Leer lassen = reine CPU-Rechnung, die Karte
# bleibt für andere Dienste frei. Zum Zuschalten:
#
#   OLLAMA_GPU=all          # jede vorhandene Karte
#   OLLAMA_GPU=GPU-1a2b...  # nur diese eine (UUID aus `nvidia-smi -L`)
#
# Voraussetzung ist die nvidia-Runtime in Docker. Auf Unraid heißt das:
# Plugin "Nvidia Driver" über die Community Apps installieren, danach den
# Server einmal neu starten. Prüfen lässt sich das mit:
#
#   docker info | grep -i runtimes
#
# Mit Karte antwortet der Coach in Sekunden statt in Minuten.
OLLAMA_GPU=

# Nur für docker compose nötig (deploy.sh erkennt das selbst): auf "nvidia"
# setzen, wenn OLLAMA_GPU gesetzt ist.
OLLAMA_RUNTIME=runc

# -------------------------------------------------------------------- Waage
# Token aus PULS: Mehr -> Waage -> Kopieren
PULS_TOKEN=

# Adresse, unter der der Waagen-Dienst PULS erreicht. Bei network_mode host ist
# das der Server selbst — der Port muss zu PULS_PORT oben passen.
PULS_URL=http://localhost:1337

# Optional: nur auf diese eine Waage hören. Die Adresse steht in PULS unter
# Mehr -> Waage -> "Gefundene Bluetooth-Geräte anzeigen", sobald du drauftrittst.
SCALE_MAC=

# Für die Körperfett-Schätzung aus der Impedanz
HEIGHT_CM=184
AGE=24
SEX=male

# Messungen unter diesem Gewicht ignorieren (Katze, Rucksack, Besuch)
MIN_WEIGHT_KG=40

# Sperrfrist zwischen zwei gemeldeten Messungen (Sekunden)
COOLDOWN_S=300

# Wie lange nach dem stabilen Gewicht auf die Impedanz gewartet wird.
# Ohne Impedanz gibt es nur das Gewicht, keine Körperwerte. Die Waage misst sie
# nur bei BARFÜSSIGEM Kontakt — mit Socken kommt sie nie. Bei dünner Haut oder
# kalten Füßen dauert es länger; dann hier hochsetzen.
IMPEDANCE_WAIT_S=12

# Zum Einrichten auf DEBUG stellen — zeigt jede empfangene Messung im Log
LOG_LEVEL=INFO
